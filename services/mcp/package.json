{
  "name": "@wotold/mcp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Local MCP server for Wotold (M8 паспорта) — read-only access to call recordings/transcripts/recaps via Claude/Cursor/etc.",
  "bin": {
    "wotold-mcp": "./dist/server.js"
  },
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node ./dist/server.js",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^11.10.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
