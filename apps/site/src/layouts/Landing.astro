---
/**
 * Оболочка лендинга — намеренно вне Starlight.
 *
 * Стартлайт даёт сайдбар, хлебные крошки и оглавление: всё это нужно докам и
 * мешает первому экрану. Поэтому `src/pages/index.astro` перекрывает корневой
 * роут Starlight, а общее у них — токены (site.css), шрифты и одно и то же
 * хранилище темы, чтобы переключатель не «забывал» выбор при переходе
 * лендинг ↔ доки.
 *
 * Шапка — по эталону handoff 2026-07-30: марка + якорная навигация
 * (#ask/#download/#faq) + доки + GitHub + языки + тема + CTA.
 */
import '../styles/site.css';
import '../styles/landing.css';
import '../styles/landing-demos.css';
import Icon from '../components/Icon.astro';
import Mark from '../components/Mark.astro';
import type { Lang, LandingCopy } from '../data/landing';

interface Props {
  lang: Lang;
  copy: LandingCopy;
}

const { lang, copy: c } = Astro.props;
const base = import.meta.env.BASE_URL;
const docs = (slug: string) => `${base}${lang === 'ru' ? '' : lang + '/'}${slug}/`;

const LOCALES = [
  { code: 'ru', label: 'RU', href: base },
  { code: 'en', label: 'EN', href: `${base}en/` },
  { code: 'kk', label: 'KK', href: `${base}kk/` },
];

const THEME_LABEL = { ru: 'Переключить тему', en: 'Toggle theme', kk: 'Тақырыпты ауыстыру' }[lang];
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://zdllucky.github.io');
---

<!doctype html>
<html lang={lang} data-density="cozy">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.meta.title}</title>
    <meta name="description" content={c.meta.description} />
    <link rel="canonical" href={canonical.href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={c.meta.title} />
    <meta property="og:description" content={c.meta.description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL(`${base}og.png`, canonical).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />

    <link
      rel="preload"
      href={`${base}fonts/onest-cyrillic-400-800.woff2`}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href={`${base}fonts/fonts.css`} />

    {/* Тема ставится до первой отрисовки — иначе тёмная тема моргает белым.
        Ключ localStorage тот же, что у Starlight, чтобы выбор переживал
        переход между лендингом и доками. Здесь же ставится data-js — гейт
        прогрессивного улучшения (без JS демо стоят в статичном состоянии). */}
    <script is:inline>
      (() => {
        document.documentElement.dataset.js = '';
        const stored = (() => {
          try {
            return localStorage.getItem('starlight-theme');
          } catch {
            return null;
          }
        })();
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>

  <body class="lp">
    <header class="lp-topbar">
      <div class="lp-hd">
        <a class="lp-wm lp-brand" href={base}><Mark />Wotold</a>

        <nav class="lp-topnav" aria-label={c.nav.docs}>
          <a href="#ask">{c.nav.features}</a>
          <a href="#download">{c.nav.download}</a>
          <a href="#faq">{c.nav.faq}</a>
          <a href={docs('features')}>{c.nav.docs}</a>
          <a href="https://github.com/zdllucky/wotold">GitHub</a>
        </nav>

        <div class="lp-topactions">
          <div class="seg" role="group" aria-label="Language">
            {
              LOCALES.map((l) => (
                <a
                  href={l.href}
                  hreflang={l.code}
                  data-active={l.code === lang ? 'true' : undefined}
                  aria-current={l.code === lang ? 'true' : undefined}
                >
                  {l.label}
                </a>
              ))
            }
          </div>

          <button class="iconbtn" type="button" data-theme-toggle aria-label={THEME_LABEL}>
            <Icon name="sun" size={16} stroke={1.7} class="lp-ico-light" />
            <Icon name="moon" size={16} stroke={1.7} class="lp-ico-dark" />
          </button>

          <a class="btn btn--primary lp-hd-cta" href="#download">{c.hero.primary}</a>
        </div>
      </div>
    </header>

    <main><slot /></main>

    <slot name="footer" />

    <script is:inline>
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('starlight-theme', next);
        } catch {
          /* приватный режим — тема просто не переживёт перезагрузку */
        }
      });
    </script>
  </body>
</html>
