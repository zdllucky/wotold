---
/**
 * Line-иконки сайта — подмножество набора приложения.
 *
 * Порт `apps/desktop/src/ui/Icon.tsx` (сам он — порт
 * `docs/design/wotold-v2/_reference/uikit-icons.jsx`): те же viewBox 24,
 * stroke 1.6, currentColor, те же имена. Копируется только то, что реально
 * нужно лендингу: тащить React-компонент на статический сайт ради десятка
 * глифов — лишние килобайты и лишняя зависимость.
 *
 * Расхождение по имени с набором приложения — ошибка. Если нужен новый глиф,
 * он берётся оттуда, а не рисуется заново.
 */
interface Props {
  name: keyof typeof ICONS;
  size?: number;
  stroke?: number;
  class?: string;
}

const ICONS = {
  code: '<path d="M9 8l-4 4 4 4M15 8l4 4-4 4" />',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5" />',
  sun: '<circle cx="12" cy="12" r="4" /><path d="M12 2.5v2.2M12 19.3v2.2M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6" />',
  moon: '<path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" />',
  lock: '<rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" />',
  locate: '<circle cx="12" cy="12" r="4" /><path d="M12 2v4M12 18v4M2 12h4M18 12h4" />',
} as const;

const { name, size = 18, stroke = 1.6, class: className } = Astro.props;
const glyph = ICONS[name];
---

{
  glyph && (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width={stroke}
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={glyph}
    />
  )
}
