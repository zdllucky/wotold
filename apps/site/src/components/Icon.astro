---
/**
 * Line-иконки сайта — подмножество набора приложения.
 *
 * Порт `apps/desktop/src/ui/Icon.tsx` (сам он — порт
 * `docs/design/wotold-v2/_reference/uikit-icons.jsx`): те же viewBox 24,
 * stroke 1.6, currentColor, те же имена. Копируется только то, что реально
 * нужно лендингу: тащить React-компонент на статический сайт ради десятка
 * глифов — лишние килобайты и лишняя зависимость.
 *
 * Расхождение по имени с набором приложения — ошибка. Если нужен новый глиф,
 * он берётся оттуда, а не рисуется заново.
 */
interface Props {
  name: keyof typeof ICONS;
  size?: number;
  stroke?: number;
  class?: string;
}

const ICONS = {
  mic: '<rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21M9 21h6" />',
  users:
    '<circle cx="9" cy="8" r="3.4" /><path d="M3 20c0-3.3 2.7-5.4 6-5.4s6 2.1 6 5.4" /><path d="M16 5.2a3.4 3.4 0 0 1 0 6.6M17.5 14.9c2.1.7 3.5 2.5 3.5 5.1" />',
  chat: '<path d="M20 12.5a7.5 7.5 0 0 1-11 6.6L4 20.5l1.4-4.6A7.5 7.5 0 1 1 20 12.5z" />',
  shield: '<path d="M12 3l7 3v5.5c0 4.3-2.9 7.9-7 9.5-4.1-1.6-7-5.2-7-9.5V6z" />',
  code: '<path d="M9 8l-4 4 4 4M15 8l4 4-4 4" />',
  waveform: '<path d="M4 10v4M8 6v12M12 8.5v7M16 4.5v15M20 10v4" />',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5" />',
  checkCircle: '<circle cx="12" cy="12" r="9" /><path d="M8 12.4l2.7 2.7L16 9.6" />',
  arrowRight: '<path d="M4 12h15M13.5 6.5L20 12l-6.5 5.5" />',
  download: '<path d="M12 3.5v12M7.5 11L12 15.5 16.5 11M4.5 20h15" />',
  external: '<path d="M14 4h6v6M20 4l-9 9M18 14v5.5H4.5V6H10" />',
  wifiOff: '<path d="M3 4l18 18" /><path d="M8.5 15.5a5 5 0 0 1 5.9-.9M5.2 12a10 10 0 0 1 4-2.4M2 8.6a15 15 0 0 1 5-3.1M11 5.1a15 15 0 0 1 11 3.5M16.6 11.2a10 10 0 0 1 2.2 1.6" /><path d="M12 19h.01" />',
  cpu: '<rect x="7" y="7" width="10" height="10" rx="2" /><path d="M10 3v3M14 3v3M10 18v3M14 18v3M3 10h3M3 14h3M18 10h3M18 14h3" />',
  sparkle:
    '<path d="M12 3.5l1.9 5.1 5.1 1.9-5.1 1.9-1.9 5.1-1.9-5.1L5 10.5l5.1-1.9z" /><path d="M18.5 16.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z" />',
  heart:
    '<path d="M12 20s-7-4.3-7-9.2A4 4 0 0 1 12 8a4 4 0 0 1 7 2.8C19 15.7 12 20 12 20z" />',
  sun: '<circle cx="12" cy="12" r="4" /><path d="M12 2.5v2.2M12 19.3v2.2M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6" />',
  moon: '<path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" />',
} as const;

const { name, size = 18, stroke = 1.6, class: className } = Astro.props;
const glyph = ICONS[name];
---

{
  glyph && (
    <svg
      class={className}
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width={stroke}
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={glyph}
    />
  )
}
