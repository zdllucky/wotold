---
/**
 * Декоративный мокап окна приложения.
 *
 * Собран на тех же примитивах, что и продукт (`wk.css`: .turn, .chip, .avatar,
 * .dot, .wave, .btn), поэтому меняется вместе с токенами и не расходится с UI.
 * Реплики — синтетические, как фикстуры ассистента: реального разговора здесь
 * быть не может.
 *
 * Для скринридера скрыт целиком: озвучивать выдуманный список звонков как
 * содержимое страницы — дезинформация. Смысл первого экрана несёт текст рядом.
 * Когда появятся настоящие скриншоты приложения, компонент заменяется на <img>
 * без правок вокруг.
 */
import Icon from '../Icon.astro';

interface Props {
  lang?: 'ru' | 'en' | 'kk';
}

const { lang = 'ru' } = Astro.props;

const COPY = {
  ru: {
    title: 'Wotold — Звонок с Акме',
    nav: ['Инбокс', 'Ассистент', 'Контакты'],
    heading: 'Планёрка по пилоту',
    meta: '32:14 · русский',
    rec: 'запись',
    speakers: ['Вы', 'Спикер 1', 'Вы'],
    turns: [
      'Предлагаю стартовать пилот с двух недель теста, потом решим по контракту.',
      'Дедлайн подписания — тридцатое мая. SOW пришлю в пятницу.',
      'Тогда фиксируем: две недели, дальше смотрим на метрики.',
    ],
    chips: ['3 решения', '5 задач'],
  },
  en: {
    title: 'Wotold — Call with Acme',
    nav: ['Inbox', 'Assistant', 'Contacts'],
    heading: 'Pilot kickoff',
    meta: '32:14 · English',
    rec: 'recording',
    speakers: ['You', 'Speaker 1', 'You'],
    turns: [
      'Let us start with a two-week pilot and decide on the contract after that.',
      'Signing deadline is May 30th. I will send the SOW on Friday.',
      'Agreed: two weeks, then we look at the metrics.',
    ],
    chips: ['3 decisions', '5 action items'],
  },
  kk: {
    title: 'Wotold — Acme қоңырауы',
    nav: ['Кіріс', 'Көмекші', 'Контактілер'],
    heading: 'Пилот бойынша жиналыс',
    meta: '32:14 · қазақша',
    rec: 'жазба',
    speakers: ['Сіз', '1-сөйлеуші', 'Сіз'],
    turns: [
      'Екі апталық пилоттан бастайық, содан кейін келісімшартты шешеміз.',
      'Қол қою мерзімі — отызыншы мамыр. SOW-ды жұмада жіберемін.',
      'Келістік: екі апта, сосын метрикаларға қараймыз.',
    ],
    chips: ['3 шешім', '5 тапсырма'],
  },
}[lang];

const TIMES = ['00:41', '02:07', '03:12'];
const SPEAKER_TOKENS = ['var(--sp1)', 'var(--sp2)', 'var(--sp1)'];
---

<div class="mock" aria-hidden="true">
  <div class="mock-bar">
    <span class="mock-lights"><i></i><i></i><i></i></span>
    <span class="mock-title">{COPY.title}</span>
  </div>

  <div class="mock-body">
    <aside class="mock-rail">
      {
        COPY.nav.map((item, i) => (
          <div class="mock-nav" data-active={i === 0 ? '' : undefined}>
            <Icon name={i === 0 ? 'waveform' : i === 1 ? 'chat' : 'users'} size={14} />
            {item}
          </div>
        ))
      }
    </aside>

    <div class="mock-main">
      <div class="mock-head">
        <div>
          <div class="mock-h">{COPY.heading}</div>
          <div class="mono u-faint" style="font-size: var(--t-11); margin-top: 2px;">
            {COPY.meta}
          </div>
        </div>
        <span class="mock-rec">
          <span class="dot dot--pulse" style="background: currentColor;"></span>
          <span class="wave"><i style="height:6px"></i><i style="height:12px"></i><i
              style="height:8px"></i><i style="height:14px"></i></span>
          {COPY.rec}
        </span>
      </div>

      <div class="mock-turns">
        {
          COPY.turns.map((text, i) => (
            <div class="turn">
              <div>
                <div class="turn-sp">
                  <span
                    class="avatar"
                    style={`width:18px;height:18px;font-size:9px;background:${SPEAKER_TOKENS[i]}`}
                  >
                    {COPY.speakers[i].slice(0, 1)}
                  </span>
                  {COPY.speakers[i]}
                </div>
                <div class="turn-time">{TIMES[i]}</div>
              </div>
              <div class="turn-text">{text}</div>
            </div>
          ))
        }
      </div>

      <div style="display:flex; gap: var(--s2); margin-top: var(--s4);">
        {COPY.chips.map((c) => <span class="chip chip--accent">{c}</span>)}
        <span class="chip chip--line">MCP</span>
      </div>
    </div>
  </div>
</div>
