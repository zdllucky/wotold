---
/**
 * Лендинг целиком — одна разметка на три локали (handoff 2026-07-30).
 *
 * Страницы (`pages/index.astro`, `pages/en/index.astro`, `pages/kk/index.astro`)
 * остаются тонкими: разъезжаться должны тексты в data/landing.ts, а не секции.
 * Порядок секций — SPEC §3: hero (живая карточка) → #ask → #trust → #download
 * → #faq → footer. Все секции внутри <main> (в эталоне были снаружи — фикс).
 */
import Landing from '../../layouts/Landing.astro';
import LiveCallCard from './LiveCallCard.astro';
import AskDemo from './AskDemo.astro';
import Icon from '../Icon.astro';
import Mark from '../Mark.astro';
import {
  LANDING,
  PROJECT_LINKS,
  DMG_URL,
  LEGAL_CONSENT_TOKEN,
  type Lang,
} from '../../data/landing';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = LANDING[lang];
const base = import.meta.env.BASE_URL;
// Доки не переведены — Starlight отдаёт русский оригинал с плашкой,
// но адрес обязан оставаться в своей локали, иначе переключатель языка
// выбрасывает читателя обратно в русскую версию.
const doc = (slug: string) => `${base}${lang === 'ru' ? '' : lang + '/'}${slug}/`;

/** HTML-строки дека несут плейсхолдер вместо абсолютного URL уведомления. */
const withConsent = (html: string) => html.replaceAll(LEGAL_CONSENT_TOKEN, doc('legal/consent'));

/* Брендовый глиф Apple для карточки Mac — заливка, не line-иконка 1.7px,
   поэтому живёт здесь, а не в Icon.astro (то же исключение, что и марка). */
const APPLE_GLYPH = `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.7 12.9c0-2 1.6-3 1.7-3-1-1.4-2.4-1.6-2.9-1.6-1.2-.1-2.4.7-3 .7-.6 0-1.6-.7-2.6-.7-1.3 0-2.6.8-3.3 2-1.4 2.4-.4 6 1 8 .7 1 1.5 2.1 2.5 2 1 0 1.4-.6 2.6-.6 1.2 0 1.5.6 2.6.6s1.8-1 2.4-2c.8-1.1 1.1-2.2 1.1-2.3-.1 0-2.1-.8-2.1-3.1zM14.7 6c.5-.7.9-1.6.8-2.5-.8 0-1.7.5-2.3 1.2-.5.6-1 1.5-.8 2.4.9.1 1.8-.4 2.3-1.1z"/></svg>`;
---

<Landing lang={lang} copy={c}>
  <section class="lp-wrap lp-hero">
    <div>
      <h1 class="lp-h1">{c.hero.title}</h1>
      <p class="lp-sub">{c.hero.lead}</p>
      <div class="lp-ctas">
        <a class="btn btn--primary lp-cta" href="#download">{c.hero.primary}</a>
        <a class="btn btn--ghost lp-ghost" href="#ask">{c.hero.secondary}</a>
      </div>
      <span class="lp-fine">{c.hero.note}</span>
    </div>
    <LiveCallCard copy={c} />
  </section>

  <section id="ask">
    <AskDemo copy={c} />
  </section>

  <section class="lp-wrap" id="trust">
    <div class="lp-sec-h">
      <h2>{c.trust.title}</h2>
    </div>
    <div class="lp-trust">
      <div class="lp-tc">
        <div class="lp-ic"><Icon name="lock" size={20} stroke={1.7} /></div>
        <b>{c.trust.c1t}</b>
        <p>{c.trust.c1b}</p>
      </div>
      <div class="lp-tc">
        <div class="lp-ic"><Icon name="locate" size={20} stroke={1.7} /></div>
        <b>{c.trust.c2t}</b>
        <p>{c.trust.c2b}</p>
      </div>
      <div class="lp-tc">
        <div class="lp-ic"><Icon name="code" size={20} stroke={1.7} /></div>
        <b>{c.trust.c3t}</b>
        <p>{c.trust.c3b}</p>
      </div>
    </div>
    <p class="lp-consent" set:html={withConsent(c.trust.consent)} />
  </section>

  <section class="lp-wrap" id="download">
    <div class="lp-sec-h">
      <h2>{c.dl.title}</h2>
    </div>
    <div class="lp-dl-grid">
      <div class="lp-dlc lp-dlc-main">
        <div class="lp-os"><Fragment set:html={APPLE_GLYPH} /><span>{c.dl.macOs}</span></div>
        <p class="lp-d">{c.dl.macD}</p>
        <a class="btn btn--primary lp-cta" href={DMG_URL}>{c.dl.macBtn}</a>
        <p class="lp-req">{c.dl.macReq}</p>
        <details>
          <summary>{c.dl.gkT}</summary>
          <p>{c.dl.gkB}</p>
        </details>
        <details>
          <summary>{c.dl.brewT}</summary>
          <p class="lp-brew"><code>brew tap zdllucky/wotold</code> <code>brew install --cask wotold</code></p>
        </details>
      </div>
      <div class="lp-dlc lp-dlc-dim">
        <span class="lp-soon">{c.dl.winTag}</span>
        <div class="lp-os">{c.dl.winOs}</div>
        <p class="lp-d">{c.dl.winD}</p>
      </div>
      <div class="lp-dlc lp-dlc-dim">
        <span class="lp-soon">{c.dl.mobTag}</span>
        <div class="lp-os">{c.dl.mobOs}</div>
        <p class="lp-d">{c.dl.mobD}</p>
      </div>
    </div>
  </section>

  <section class="lp-wrap" id="faq">
    <div class="lp-sec-h">
      <h2>{c.faq.title}</h2>
    </div>
    <div class="lp-faq">
      {
        c.faq.items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <div class="lp-fa" set:html={withConsent(item.a)} />
          </details>
        ))
      }
    </div>
  </section>

  <footer class="lp-footer" slot="footer">
    <div class="lp-wrap lp-ft">
      <div>
        <span class="lp-wm"><Mark width={30} height={21} />Wotold</span>
        <p class="lp-tagline">{c.footer.tagline}</p>
        <p class="lp-lic">{c.footer.license}</p>
      </div>
      <nav aria-label={c.footer.linksHeading}>
        <h3>{c.footer.linksHeading}</h3>
        <ul>
          {
            PROJECT_LINKS.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav aria-label={c.footer.legalHeading}>
        <h3>{c.footer.legalHeading}</h3>
        <ul>
          {
            c.footer.legal.map((l) => (
              <li>
                <a href={doc(l.slug)}>{l.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </footer>
</Landing>
