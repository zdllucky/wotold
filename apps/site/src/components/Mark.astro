---
/**
 * Марка Wotold — два скруглённых прямоугольника (handoff 2026-07-30, SPEC §8).
 * Цвета фиксированы политикой: верхний — цвет текста темы, нижний — faint.
 * Не перекрашивать в акценты (см. design gate). Размер по умолчанию — шапка
 * лендинга (34×24); футер и доки используют 30×21.
 */
interface Props {
  width?: number;
  height?: number;
  class?: string;
}

const { width = 34, height = 24, class: className } = Astro.props;
---

<svg
  width={width}
  height={height}
  viewBox="0 0 72 50"
  fill="none"
  aria-hidden="true"
  class={className}
>
  <rect x="3" y="6" width="56" height="17" rx="8.5" style="fill: var(--text)"></rect>
  <rect x="13" y="27" width="56" height="17" rx="8.5" style="fill: var(--text-faint)"></rect>
</svg>
