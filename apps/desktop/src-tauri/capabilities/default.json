{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set: core + updater (M11.6) + dialog (confirms) + shell (audio sidecar + OAuth open + M12 local-engine sidecars) + deep-link. [Security M-3] args.validator regex здесь — последняя граница. Primary control — Rust-side path construction (constants + UUIDs) + ensure_path_under() в local_engine::llm.",
  "windows": ["main", "recording-widget"],
  "permissions": [
    "core:default",
    "updater:default",
    "dialog:default",
    "deep-link:default",
    "notification:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/wotold-audio", "sidecar": true, "args": false },
        {
          "name": "binaries/wotold-llama",
          "sidecar": true,
          "args": [
            "-m",
            { "validator": "^[A-Za-z0-9._/ \\-]+$" },
            "--temp",
            { "validator": "^[0-9]+(\\.[0-9]+)?$" },
            "--ctx-size",
            { "validator": "^[0-9]+$" },
            "--n-predict",
            { "validator": "^[0-9]+$" },
            "--threads",
            { "validator": "^[0-9]+$" },
            "-ngl",
            { "validator": "^[0-9]+$" },
            "--no-conversation",
            "--no-display-prompt",
            "--simple-io",
            "--log-disable",
            "-f",
            { "validator": "^[A-Za-z0-9._/ \\-]+$" }
          ]
        },
        {
          "name": "binaries/wotold-whisper",
          "sidecar": true,
          "args": [
            "-m",
            { "validator": "^[A-Za-z0-9._/ \\-]+$" },
            "-f",
            { "validator": "^[A-Za-z0-9._/ \\-]+$" },
            "--output-json-full",
            "-of",
            { "validator": "^[A-Za-z0-9._/ \\-]+$" },
            "-l",
            { "validator": "^[a-z]{2,5}$" },
            "--threads",
            { "validator": "^[0-9]+$" },
            "--no-prints"
          ]
        }
      ]
    },
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "https://accounts.google.com/o/oauth2/**" },
        { "url": "https://appleid.apple.com/auth/**" },
        { "url": "https://login.microsoftonline.com/**/oauth2/**" },
        { "url": "https://wotold-proxy-staging.animereader.workers.dev/v1/auth/**" },
        { "url": "https://wotold-proxy.animereader.workers.dev/v1/auth/**" }
      ]
    }
  ]
}
