{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set: core + updater (M11.6) + dialog (confirms) + shell (audio sidecar + OAuth open) + deep-link",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "dialog:default",
    "deep-link:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/wotold-audio", "sidecar": true, "args": false }
      ]
    },
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "https://accounts.google.com/**" },
        { "url": "https://appleid.apple.com/**" },
        { "url": "https://login.microsoftonline.com/**" },
        { "url": "https://wotold-proxy-staging.animereader.workers.dev/**" },
        { "url": "https://wotold-proxy.animereader.workers.dev/**" }
      ]
    }
  ]
}
