{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wotold",
  "version": "0.0.1",
  "identifier": "app.wotold.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "../../scripts/build-audio-sidecar.sh && pnpm dev",
    "beforeBuildCommand": "../../scripts/build-audio-sidecar.sh && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Wotold",
        "width": 980,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/wotold-audio"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["wotold"]
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/zdllucky/wotold/releases/latest/download/latest.json"
      ],
      "pubkey": "PLACEHOLDER_TAURI_PUBKEY_REPLACE_UNDER_ETAP_11",
      "dialog": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
